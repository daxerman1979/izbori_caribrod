<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mapa - Dimitrovgrad, Srbija</title>
    
    <!-- Učitavanje Leaflet CSS-a (besplatna biblioteka za mape) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
          crossorigin=""/>

    <style>
        /* Osnovni stilovi za stranicu da zauzme ceo ekran */
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            font-family: Arial, sans-serif;
        }

        /* Stil za zaglavlje */
        header {
            background-color: #2c3e50;
            color: white;
            padding: 15px 20px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        header h1 {
            margin: 0;
            font-size: 24px;
        }

        /* Kontejner u kojem će se prikazivati mapa (mora imati definisanu visinu) */
        #map {
            width: 100%;
            height: calc(100vh - 60px); /* Visina celog ekrana minus visina zaglavlja */
        }
    </style>
</head>
<body>

    <header>
        <h1>Dimitrovgrad, Srbija</h1>
    </header>

    <!-- Element gde će Leaflet učitati mapu -->
    <div id="map"></div>

    <!-- Učitavanje Leaflet JavaScript biblioteke -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
            crossorigin=""></script>

    <script>
        // Inicijalizacija mape: koordinate za Dimitrovgrad (Širina: 43.0186, Dužina: 22.7447), zum je podešen na 14
        var map = L.map('map').setView([43.0186, 22.7447], 14);

        // Dodavanje besplatnih OpenStreetMap slojeva (pločica) sa mapom
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> saradnici'
        }).addTo(map);

        // Dodavanje markera (crvene igle) na centar Dimitrovgrada sa propratnim tekstom
        var marker = L.marker([43.0186, 22.7447]).addTo(map);
        marker.bindPopup("<b>Dimitrovgrad</b><br>Dobrodošli!").openPopup();
    </script>

</body>
</html>
